# ── Shopify App Credentials ──────────────────────────────────────────
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_REDIRECT_URI=https://your-domain.com/auth/callback
SHOPIFY_SCOPES=read_products,write_products,read_content,write_content,read_translations,write_translations

# ── Shopify API Version ─────────────────────────────────────────────
SHOPIFY_API_VERSION=2026-07

# ── Encryption ──────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
FLASK_SECRET_KEY=

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Billing ─────────────────────────────────────────────────────────
# Set to "true" for development stores (avoids real charges)
BILLING_TEST_MODE=true
# Optional trial days for paid plans
BILLING_TRIAL_DAYS=0

# ── CORS ────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
